# Configuração da API. Copie para backend/.env (ignorado pelo git) e preencha.
# Sem DATAPULSE_DATABASE_URL e DATAPULSE_S3_BUCKET, tudo fica na pasta local (bom para testar).

# --- Banco de dados (qualquer Postgres) ---------------------------------------------
# Supabase: botão "Connect" > "Session pooler" > copie a URI e troque [YOUR-PASSWORD]
# pela senha do banco. Trocar de provedor = trocar só esta linha.
DATAPULSE_DATABASE_URL=

# --- Arquivos (qualquer armazenamento compatível com S3) ---------------------------
# Supabase: Storage > S3 (ou Storage > Settings > S3 Connection) > "New access key".
DATAPULSE_S3_BUCKET=datapulse
DATAPULSE_S3_ENDPOINT=https://SEU-PROJETO.storage.supabase.co/storage/v1/s3
DATAPULSE_S3_REGION=sa-east-1
DATAPULSE_S3_ACCESS_KEY=
DATAPULSE_S3_SECRET_KEY=

# --- Geral ----------------------------------------------------------------------------
# Pasta usada quando banco/S3 não estão configurados.
DATAPULSE_STORAGE_DIR=./storage
# Origens liberadas no CORS, separadas por vírgula (o dev server do Frontend roda na 8080).
DATAPULSE_CORS_ORIGINS=http://localhost:8080,http://localhost:5173
# Tamanho máximo de upload, em MB.
DATAPULSE_MAX_UPLOAD_MB=200
