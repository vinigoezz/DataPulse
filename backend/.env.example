# Pasta onde os datasets importados são guardados (Parquet + metadados).
DATAPULSE_STORAGE_DIR=./storage
# Origens liberadas no CORS, separadas por vírgula (o dev server do Frontend roda na 8080).
DATAPULSE_CORS_ORIGINS=http://localhost:8080,http://localhost:5173
# Tamanho máximo de upload, em MB.
DATAPULSE_MAX_UPLOAD_MB=200
